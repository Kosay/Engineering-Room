rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsOrganization(orgId) {
      return signedIn() &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    match /organizations/{orgId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /{document=**} {
        allow read, write: if ownsOrganization(orgId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
