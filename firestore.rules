rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsOrganization(orgId) {
      return signedIn() &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    function nonTerminalStatus(data) {
      return data.get('status', '') != 'verified' &&
        data.get('status', '') != 'disproved';
    }

    match /organizations/{orgId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /{document=**} {
        allow read: if ownsOrganization(orgId);
        allow create: if ownsOrganization(orgId) && nonTerminalStatus(request.resource.data);
        allow update: if ownsOrganization(orgId) &&
          nonTerminalStatus(resource.data) &&
          nonTerminalStatus(request.resource.data);
        allow delete: if ownsOrganization(orgId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
